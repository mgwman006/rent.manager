type Query {
    leasePaymentStatus(leaseId: ID!): RentCollectionSummary
}

type Subscription {
    rentCollectionUpdates(leaseId: ID!): RentCollectionSummary!
}

type Mutation {
    createTenant(input: TenantInput!): Tenant!
    updateTenant(id: ID!, input: TenantInput!): Tenant
    deleteTenant(id: ID!): Boolean!
}

type RentCollectionSummary {
    leaseId: ID!
    totalExpectedAmount: BigDecimal!
    totalPaidAmount: BigDecimal!
    totalOutstandingAmount: BigDecimal!,
    status: String!,
    paymentBlocks: [PaymentBlockSummary!]!
}

type PaymentBlockSummary {
    id: ID!
    amount: BigDecimal!
    paidAmount: BigDecimal!
    outstandingAmount: BigDecimal!
    startDate: String
    endDate: String
    dueDate: String
    status: String!
}

type Tenant {
    id: ID!
    userId: ID!
    firstName: String!
    lastName: String!
    email: String!
    phoneNumber: String!
}

input TenantInput {
    email: String
    phoneNumber: String!
}

scalar BigDecimal